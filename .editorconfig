root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = 100

[*.{sh,bash}]
indent_size = 2
switch_case_indent = true

[*.qml]
indent_size = 4

[Makefile]
indent_style = tab
