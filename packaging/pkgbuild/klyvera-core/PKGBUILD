# Maintainer: Klyvera <maintainer@klyvera.invalid>
pkgname=klyvera-core
pkgver=0.1.0
pkgrel=1
pkgdesc="Klyvera Core daemon, command-line interface and local state"
arch=('x86_64')
url="https://github.com/nurlancoder/Klyvera"
license=('Apache-2.0')
depends=('gcc-libs' 'glibc' 'systemd')
makedepends=('cargo' 'rust')
options=('!debug')
source=("klyvera-$pkgver.tar.gz")
# The prototype builds from a checkout archive. Replace SKIP with updpkgsums
# output before publishing signed release packages.
sha256sums=('SKIP')

build() {
  cd "$srcdir/klyvera-$pkgver/core"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked --workspace --bins
}

package() {
  cd "$srcdir/klyvera-$pkgver"
  install -Dm755 "$srcdir/target/release/klyvera" "$pkgdir/usr/bin/klyvera"
  install -Dm755 "$srcdir/target/release/klyvera-daemon" \
    "$pkgdir/usr/bin/klyvera-daemon"
  install -Dm644 packaging/systemd/klyvera-daemon.service \
    "$pkgdir/usr/lib/systemd/user/klyvera-daemon.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/spaces-spec.md "$pkgdir/usr/share/doc/$pkgname/spaces-spec.md"
}
