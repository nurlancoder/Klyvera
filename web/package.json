    "test:browser": "node ../tests/web/browser_test.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
